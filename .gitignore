# Python
backend/.venv/
backend/venv/
backend/.venv-build/
**/__pycache__/
*.pyc
backend/build/
backend/dist/
*.spec

# Flutter/Dart
frontend/build/
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.pub-cache/
frontend/.pub/
frontend/**/ephemeral/
# Backend binary copied in by scripts/build_all.*; the folder itself must exist
# for pubspec's asset entry, hence the .gitkeep
frontend/assets/backend/*
!frontend/assets/backend/.gitkeep

# Installer staging and output (scripts/build_installer.ps1)
installer/build/
installer/output/

# Logs
*.log

# Dev scratch artifacts (screenshots, ad-hoc capture scripts)
scratch_shots/

# Editor/OS
.DS_Store
.idea/
.claude/
